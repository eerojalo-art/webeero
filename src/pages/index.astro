---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import eeroPhoto from "@/assets/images/eero-jalo.png";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import config from "@/config";

const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const work = [
  {
    name: "Project ACUMEN",
    category: "Applied AI & Digital Twins",
    description:
      "AI-enabled traffic optimization using a digital twin approach, bringing together operational data and aerial telemetry to support better decisions.",
    tags: ["AI", "Traffic optimization", "Aerial telemetry"],
  },
  {
    name: "Project SEDIMARK",
    category: "Data Platforms & Smart Infrastructure",
    description:
      "A decentralized data marketplace focused on trusted data sharing and enabling organizations to create value across data spaces.",
    tags: ["Data spaces", "Data marketplace", "Interoperability"],
  },
  {
    name: "UrbanSense & 6Aika",
    category: "Smart Infrastructure",
    description:
      "An Azure-based smart city data platform and 5G open testbed connecting cities, companies, and research organizations.",
    tags: ["Azure", "Smart cities", "Open testbed"],
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={getRelativeLocaleUrl(locale, "")}
    class="app-layout my-1"
  >
    <!-- Hero Section -->
    <section
      id="hero"
      class="border-border relative grid overflow-hidden border-b py-16 sm:py-24 md:grid-cols-[1fr_18rem] md:items-center md:gap-10"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-32 -right-32 size-96 rounded-full bg-sky-500/10 blur-3xl"
      >
      </div>
      <div class="relative">
        <p
          class="mb-5 flex items-center gap-2 text-sm font-semibold tracking-[0.18em] text-sky-400 uppercase"
        >
          <span class="size-2 rounded-full bg-sky-400"></span>
          Technology & Program Leadership
        </p>
        <h1
          class="max-w-4xl text-4xl leading-tight font-bold tracking-tight sm:text-6xl"
        >
          Turning complex technology into <span class="text-sky-400"
            >measurable impact.</span
          >
        </h1>
        <p
          class="text-muted-foreground mt-6 max-w-3xl text-lg leading-8 sm:text-xl"
        >
          I’m Eero Jalo, a technology and program leader working across applied
          AI, digital twins, data platforms, and smart infrastructure. I align
          multidisciplinary teams, partners, and investment around outcomes that
          make a difference in the real world.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#work"
            class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-5 py-3 font-semibold text-slate-950 transition hover:bg-sky-300"
          >
            Explore selected work
            <IconArrowRight class="size-4" />
          </a>
          <a
            href="mailto:eero.jalo@gmail.com"
            class="border-border inline-flex items-center gap-2 rounded-lg border px-5 py-3 font-semibold transition hover:border-sky-400 hover:text-sky-300"
          >
            Get in touch
            <span data-lucide="arrow-up-right" class="size-4" aria-hidden="true"
            ></span>
          </a>
        </div>
        {
          socials.length > 0 && (
            <div class="mt-7 flex items-center gap-4">
              <span class="text-muted-foreground text-sm">Connect</span>
              <Socials />
            </div>
          )
        }
      </div>
      <Image
        src={eeroPhoto}
        alt="Portrait of Eero Jalo"
        widths={[320, 480, 640]}
        sizes="(min-width: 768px) 18rem, (min-width: 640px) 28rem, calc(100vw - 2rem)"
        class="border-border relative mx-auto mt-10 aspect-square w-full max-w-72 rounded-2xl border object-cover shadow-2xl shadow-sky-950/30 md:mt-0 md:max-w-none"
      />
    </section>

    <!-- Core Pillars -->
    <section id="expertise" class="border-border border-b py-14 sm:py-16">
      <div class="mb-8">
        <p
          class="mb-2 text-sm font-semibold tracking-[0.16em] text-sky-400 uppercase"
        >
          What I do
        </p>
        <h2 class="text-3xl font-bold tracking-tight">
          Where strategy meets delivery
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <article class="border-border rounded-xl border bg-white/[0.03] p-6">
          <span
            data-lucide="brain-circuit"
            class="mb-5 size-6 text-sky-400"
            aria-hidden="true"></span>
          <h3 class="text-lg font-semibold">Applied AI & Digital Twins</h3>
          <p class="text-muted-foreground mt-3 leading-7">
            Translating AI, operational data, and digital twin capabilities into
            practical solutions for complex environments.
          </p>
        </article>
        <article class="border-border rounded-xl border bg-white/[0.03] p-6">
          <span
            data-lucide="network"
            class="mb-5 size-6 text-sky-400"
            aria-hidden="true"></span>
          <h3 class="text-lg font-semibold">
            Data Platforms & Smart Infrastructure
          </h3>
          <p class="text-muted-foreground mt-3 leading-7">
            Building the partnerships and foundations for data-driven services,
            decentralized data spaces, and connected infrastructure.
          </p>
        </article>
        <article class="border-border rounded-xl border bg-white/[0.03] p-6">
          <span
            data-lucide="workflow"
            class="mb-5 size-6 text-sky-400"
            aria-hidden="true"></span>
          <h3 class="text-lg font-semibold">Technical Program Delivery</h3>
          <p class="text-muted-foreground mt-3 leading-7">
            Aligning people, governance, and investment to deliver complex,
            multi-stakeholder programs from strategy through execution.
          </p>
        </article>
      </div>
    </section>

    <!-- Selected Work -->
    <section id="work" class="border-border border-b py-14 sm:py-16">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p
            class="mb-2 text-sm font-semibold tracking-[0.16em] text-sky-400 uppercase"
          >
            Selected initiatives
          </p>
          <h2 class="text-3xl font-bold tracking-tight">
            Technology with real-world purpose
          </h2>
        </div>
        <span class="text-muted-foreground text-sm"
          >AI · data · infrastructure</span
        >
      </div>
      <div class="grid gap-4 lg:grid-cols-3">
        {
          work.map((project, index) => (
            <article class="border-border flex flex-col rounded-xl border bg-white/[0.03] p-6">
              <div class="mb-6 flex items-center justify-between">
                <span class="text-sm font-semibold text-sky-400">
                  0{index + 1}
                </span>
                <span
                  data-lucide="arrow-up-right"
                  class="text-muted-foreground size-4"
                  aria-hidden="true"
                />
              </div>
              <p class="text-muted-foreground text-xs font-semibold tracking-wide uppercase">
                {project.category}
              </p>
              <h3 class="mt-2 text-xl font-bold">{project.name}</h3>
              <p class="text-muted-foreground mt-3 flex-1 leading-7">
                {project.description}
              </p>
              <ul
                class="mt-6 flex flex-wrap gap-2"
                aria-label={`${project.name} focus areas`}
              >
                {project.tags.map(tag => (
                  <li class="border-border text-muted-foreground rounded-full border px-3 py-1 text-xs">
                    {tag}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Program Delivery -->
    <section
      class="border-border grid gap-8 border-b py-14 sm:py-16 md:grid-cols-[1fr_1.2fr]"
    >
      <div>
        <p
          class="mb-2 text-sm font-semibold tracking-[0.16em] text-sky-400 uppercase"
        >
          From vision to execution
        </p>
        <h2 class="text-3xl font-bold tracking-tight">
          Complex programs. Shared outcomes.
        </h2>
      </div>
      <div>
        <p class="text-muted-foreground leading-7">
          More than two decades delivering high-availability systems and
          distributed infrastructure have shaped how I lead: with clear
          accountability, production-minded execution, and a focus on outcomes.
          I bring public and private stakeholders together across European and
          regional innovation programs.
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <div class="border-border rounded-lg border p-4">
            <p class="font-semibold">Program governance</p>
            <p class="text-muted-foreground mt-1 text-sm">
              Horizon Europe · EAKR · multi-million € budgets
            </p>
          </div>
          <div class="border-border rounded-lg border p-4">
            <p class="font-semibold">Ways of working</p>
            <p class="text-muted-foreground mt-1 text-sm">
              EU projects · PRINCE2 · SAFe · Agile · Lean · PROPS · Scrum
            </p>
          </div>
          <div class="border-border rounded-lg border p-4">
            <p class="font-semibold">Systems perspective</p>
            <p class="text-muted-foreground mt-1 text-sm">
              High availability · distributed edge · telemetry
            </p>
          </div>
          <div class="border-border rounded-lg border p-4">
            <p class="font-semibold">Languages</p>
            <p class="text-muted-foreground mt-1 text-sm">
              Finnish · English · Swedish
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-14 text-center sm:py-16">
      <p
        class="mb-2 text-sm font-semibold tracking-[0.16em] text-sky-400 uppercase"
      >
        Let’s build what’s next
      </p>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Have a challenge worth solving?
      </h2>
      <p class="text-muted-foreground mx-auto mt-4 max-w-2xl leading-7">
        I’m always interested in ambitious programs at the intersection of AI,
        data, and infrastructure.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a
          href="mailto:eero.jalo@gmail.com"
          class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-5 py-3 font-semibold text-slate-950 transition hover:bg-sky-300"
        >
          Start a conversation
          <span data-lucide="mail" class="size-4" aria-hidden="true"></span>
        </a>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "about")}
          class="border-border rounded-lg border px-5 py-3 font-semibold hover:border-sky-400 hover:text-sky-300"
        >
          More about me
        </LinkButton>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
